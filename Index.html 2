<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Multiplayer Klickspiel</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #111;
      color: #fff;
      text-align: center;
      margin: 0;
      padding: 20px;
    }

    h1 {
      margin-bottom: 5px;
    }

    #status {
      color: #aaa;
      margin-bottom: 20px;
    }

    #board {
      display: grid;
      grid-template-columns: repeat(3, 120px);
      gap: 10px;
      justify-content: center;
    }

    .cell {
      width: 120px;
      height: 120px;
      border: none;
      border-radius: 12px;
      background: #2a2a2a;
      color: white;
      font-size: 28px;
      cursor: pointer;
      transition: background 0.15s;
    }

    .cell:hover {
      background: #3d3d3d;
    }

    .cell.player1 { background: #e74c3c; }
    .cell.player2 { background: #3498db; }

    .cell:disabled {
      cursor: not-allowed;
      opacity: 0.8;
    }

    #winner {
      font-size: 24px;
      margin-top: 20px;
      min-height: 30px;
    }

    #restart {
      margin-top: 15px;
      padding: 10px 20px;
      font-size: 16px;
      border: none;
      border-radius: 8px;
      background: #27ae60;
      color: white;
      cursor: pointer;
    }

    #restart:disabled {
      background: #555;
      cursor: not-allowed;
    }
  </style>
</head>
<body>

  <h1>Multiplayer Klickspiel</h1>
  <p id="status">Verbinde mit Server …</p>

  <div id="board"></div>

  <p id="winner"></p>
  <button id="restart" disabled>Neues Spiel</button>

  <script>
    // Bei lokalem Test: ws://localhost:3000
    // Im Internet: wss://deine-server-domain.de
    const socket = new WebSocket("ws://localhost:3000");

    const status = document.getElementById("status");
    const board = document.getElementById("board");
    const winner = document.getElementById("winner");
    const restartButton = document.getElementById("restart");

    let myPlayer = null;
    let gameStarted = false;

    const cells = [];

    for (let i = 0; i < 9; i++) {
      const cell = document.createElement("button");
      cell.className = "cell";
      cell.dataset.index = i;
      cell.disabled = true;
      cell.addEventListener("click", () => {
        socket.send(JSON.stringify({
          type: "move",
          cell: Number(cell.dataset.index)
        }));
      });
      board.appendChild(cell);
      cells.push(cell);
    }

    socket.addEventListener("open", () => {
      status.textContent = "Warte auf zweiten Spieler …";
    });

    socket.addEventListener("message", (event) => {
      const data = JSON.parse(event.data);

      if (data.type === "welcome") {
        myPlayer = data.player;
        status.textContent = `Du bist Spieler ${myPlayer}. Warte auf Gegner …`;
      }

      if (data.type === "start") {
        gameStarted = true;
        status.textContent = "Spiel gestartet!";
        restartButton.disabled = true;
        winner.textContent = "";
      }

      if (data.type === "state") {
        updateBoard(data.board, data.currentPlayer);
        status.textContent = data.currentPlayer === myPlayer
          ? "Du bist am Zug!"
          : "Gegner ist am Zug …";
      }

      if (data.type === "win") {
        updateBoard(data.board, null);
        winner.textContent = data.winner === myPlayer
          ? "Du hast gewonnen! 🎉"
          : "Gegner hat gewonnen.";
        restartButton.disabled = false;
      }

      if (data.type === "draw") {
        updateBoard(data.board, null);
        winner.textContent = "Unentschieden!";
        restartButton.disabled = false;
      }

      if (data.type === "restart") {
        resetBoard();
        status.textContent = "Neues Spiel gestartet!";
      }
    });

    socket.addEventListener("close", () => {
      status.textContent = "Verbindung getrennt. Server neu starten und Seite neu laden.";
    });

    restartButton.addEventListener("click", () => {
      socket.send(JSON.stringify({ type: "restart" }));
    });

    function updateBoard(boardState, currentPlayer) {
      cells.forEach((cell, index) => {
        cell.textContent = boardState[index] || "";
        cell.className = "cell";

        if (boardState[index] === 1) cell.classList.add("player1");
        if (boardState[index] === 2) cell.classList.add("player2");

        cell.disabled =
          !gameStarted ||
          boardState[index] !== null ||
          currentPlayer !== myPlayer;
      });
    }

    function resetBoard() {
      cells.forEach(cell => {
        cell.textContent = "";
        cell.className = "cell";
        cell.disabled = false;
      });
      winner.textContent = "";
    }
  </script>

</body>
</html>
